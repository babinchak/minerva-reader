# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Chat model for agent graph (LangChain). Default: gpt-5.4-mini
# OPENAI_MODEL=gpt-5.4-mini

# Optional: use a different model for title generation (e.g. gpt-5.4-mini for short outputs)
# OPENAI_TITLE_MODEL=gpt-5.4-mini

# LangSmith: tracing for Agentic mode uses LANGSMITH_API_KEY (and LANGSMITH_TRACING if needed)

# Agentic mode: web search (Tavily)
# TAVILY_API_KEY=your-tavily-api-key

# Admin: comma-separated emails that can access /admin (delete books, etc.)
# ADMIN_EMAILS=admin@example.com

# Summaries Lambda URLs (for admin regenerate actions)
# SUMMARIES_API_URL=https://xxx.execute-api.region.amazonaws.com/prod/summaries
# PDF_SUMMARIES_API_URL=https://xxx.lambda-url.region.on.aws/

# Free beta: when set (e.g. 1 or true), all users get paid-tier access (unlimited uploads, AI).
# Usage section still shows real prices; nothing shown as "included".
# FREE_BETA_MODE=1

# Monetization: tier models (map to OpenAI model IDs)
# OPENAI_MODEL_ANONYMOUS=gpt-5.4-mini
# OPENAI_MODEL_FREE=gpt-5.4-mini
# OPENAI_MODEL_PAID=gpt-5.4

# Usage allowances (dollars). Free = daily, Paid = monthly.
# ALLOWANCE_DOLLARS_FREE_DAILY=0.50
# ALLOWANCE_DOLLARS_PAID=20

# Stripe (paid tier)
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (for local: use secret from "stripe listen" output)
# STRIPE_PRICE_ID_PRO=price_...  (subscription)
# STRIPE_PRICE_ID_OVERAGE=price_...  (metered, for on-demand billing - create in Stripe Dashboard)
